{
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#5E8F6E" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },
      "primary-pressed": { "$type": "color", "$value": "#4A7257" }
    },
    "surface": { "$type": "color", "$value": { "light": "{color.neutral.50}", "dark": "{color.neutral.900}" } },
    "surface-raised": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "{color.neutral.800}" } },
    "text-primary": { "$type": "color", "$value": { "light": "#1A1A1A", "dark": "#F2F2F2" } },
    "text-secondary": { "$type": "color", "$value": { "light": "#5A5A5A", "dark": "#A3A3A8" } },
    "success": { "$type": "color", "$value": "#2E6B3E" },
    "success-light": { "$type": "color", "$value": "#8FBF9F" },
    "error": { "$type": "color", "$value": "#B3261E" },
    "neutral": {
      "50": { "$type": "color", "$value": "#F7F7F5" },
      "200": { "$type": "color", "$value": "#E0E0DC" },
      "700": { "$type": "color", "$value": "#3A3A3C" },
      "800": { "$type": "color", "$value": "#1C1C1E" },
      "900": { "$type": "color", "$value": "#121212" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4" },
    "2": { "$type": "dimension", "$value": "8" },
    "4": { "$type": "dimension", "$value": "16" },
    "6": { "$type": "dimension", "$value": "24" },
    "8": { "$type": "dimension", "$value": "32" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8" },
    "lg": { "$type": "dimension", "$value": "16" },
    "xl": { "$type": "dimension", "$value": "22" }
  },
  "typography": {
    "caption": { "$type": "fontSize", "$value": "12" },
    "body": { "$type": "fontSize", "$value": "16" },
    "heading": { "$type": "fontSize", "$value": "20" },
    "title": { "$type": "fontSize", "$value": "28" }
  }
}
